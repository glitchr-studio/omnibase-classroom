<div class="analytics-card card classroom-overview">
    <div class="analytics-card-header"><h2 class="analytics-card-title">{{ widget.label|trans({}, 'admin') }}</h2></div>
    <div class="classroom-overview-tiles">
    {% for key, tile in tiles %}
        <a class="classroom-overview-tile{{ tile.alert is defined and tile.value > 0 ? ' is-waiting' }}" href="{{ path('admin_crud_' ~ tile.crud ~ '_index') }}">
            <strong>{{ tile.value }}</strong><span>{{ ('@classroom.admin.widget.' ~ key)|trans }}</span>
        </a>
    {% endfor %}
    </div>
</div>
<style>
    .classroom-overview-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: .75rem; padding: 0 1rem 1rem; }
    .classroom-overview-tile { display: grid; gap: .25rem; padding: .9rem 1rem; border-radius: .75rem; background: rgba(127,127,127,.08); color: inherit; text-decoration: none; }
    .classroom-overview-tile strong { font-size: 1.6rem; line-height: 1.1; }
    .classroom-overview-tile span { font-size: .8rem; opacity: .75; }
    .classroom-overview-tile:hover { background: rgba(127,127,127,.16); }
    .classroom-overview-tile.is-waiting { background: rgba(252,104,117,.16); }
    .classroom-overview-tile.is-waiting strong { color: #d9404e; }
</style>
