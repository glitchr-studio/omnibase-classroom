<article class="classroom-card is-resource">
    <a class="classroom-card-cover" href="{{ path('classroom_resource', {slug: resource.slug}) }}">{% if resource.preview %}<img src="{{ resource.preview }}" alt="" loading="lazy">{% else %}<span class="classroom-card-ext" aria-hidden="true">{{ resource.extension|upper }}</span>{% endif %}</a>
    <div class="classroom-card-body">
        <p class="classroom-card-pills">{% include '@Classroom/client/_pills.html.twig' with {thing: resource} %}<span class="classroom-pill is-small is-{{ resource.visibility.value }}">{{ ('@classroom.resource.visibility.' ~ resource.visibility.value)|trans }}</span></p>
        <h3><a href="{{ path('classroom_resource', {slug: resource.slug}) }}">{{ resource.title }}</a></h3>
        <p class="classroom-card-meta">{{ resource.extension|upper }}{% if resource.size %} · {{ resource.size|classroom_size }}{% endif %} · {{ '@classroom.resource.downloads'|trans({count: resource.downloads}) }}</p>
    </div>
</article>
